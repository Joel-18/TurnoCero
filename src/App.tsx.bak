import { useEffect, useMemo, useState } from 'react'
import { createClient } from '@supabase/supabase-js'
import { Activity, ArrowLeft, ArrowRight, CalendarDays, Check, CheckCircle2, ChevronDown, Clock3, HeartPulse, LogOut, Menu, Plus, Search, ShieldCheck, Sparkles, Stethoscope, Sun, Moon, UserRound, X } from 'lucide-react'

const supabaseUrl = import.meta.env.VITE_SUPABASE_URL as string | undefined
const supabaseKey = import.meta.env.VITE_SUPABASE_ANON_KEY as string | undefined
const supabase = supabaseUrl && supabaseKey ? createClient(supabaseUrl, supabaseKey) : null

type Doctor = { id:string; name:string; specialty:string; initials:string; color:string; location:string; next:string; rating:string; fee:number }
type Booking = { id:string; doctorId:string; doctor:string; specialty:string; initials:string; color:string; date:string; time:string; status:'Confirmada'|'Pendiente'|'Cancelada'; location:string }
