 {id:'d41',name:'Dra. Elena Paredes',specialty:'Pediatría',initials:'EP',color:'peach',location:'Consultorio 124 · Sede Piantini',next:'Vie, 10:00 a. m.',rating:'4.9',fee:1650},
 {id:'d42',name:'Dr. Carlos Medina',specialty:'Pediatría',initials:'CM',color:'sage',location:'Consultorio 225 · Sede Bella Vista',next:'Vie, 1:00 p. m.',rating:'4.7',fee:1500},
 {id:'d43',name:'Dra. Alicia García',specialty:'Ginecología',initials:'AG',color:'rose',location:'Consultorio 408 · Sede Naco',next:'Hoy, 4:00 p. m.',rating:'4.9',fee:2050},
 {id:'d44',name:'Dr. Luis Cedeño',specialty:'Ginecología',initials:'LC',color:'blue',location:'Consultorio 410 · Sede Bella Vista',next:'Mañana, 9:00 a. m.',rating:'4.8',fee:2000},
 {id:'d45',name:'Dra. Fernanda Suárez',specialty:'Ginecología',initials:'FS',color:'peach',location:'Consultorio 412 · Sede Piantini',next:'Mañana, 11:00 a. m.',rating:'4.9',fee:2150},
 {id:'d46',name:'Dr. Andrés Jiménez',specialty:'Ginecología',initials:'AJ',color:'sage',location:'Consultorio 414 · Sede Naco',next:'Jue, 8:30 a. m.',rating:'4.7',fee:1950},
 {id:'d47',name:'Dra. Raquel Bautista',specialty:'Ginecología',initials:'RB',color:'lavender',location:'Consultorio 416 · Sede Bella Vista',next:'Jue, 10:30 a. m.',rating:'5.0',fee:2200},
 {id:'d48',name:'Dra. Laura Paniagua',specialty:'Ginecología',initials:'LP',color:'rose',location:'Consultorio 418 · Sede Piantini',next:'Vie, 9:30 a. m.',rating:'4.8',fee:2050},
 {id:'d49',name:'Dr. Sergio Lara',specialty:'Ginecología',initials:'SL',color:'blue',location:'Consultorio 420 · Sede Naco',next:'Vie, 11:30 a. m.',rating:'4.8',fee:2000},
 {id:'d50',name:'Dra. Verónica Rivas',specialty:'Ginecología',initials:'VR',color:'peach',location:'Consultorio 422 · Sede Bella Vista',next:'Vie, 2:30 p. m.',rating:'4.9',fee:2150},
]
const specialties=['Todas','Medicina general','Cardiología','Dermatología','Pediatría','Ginecología']
const slots=['8:30 a. m.','9:00 a. m.','9:30 a. m.','10:00 a. m.','10:30 a. m.','11:00 a. m.','11:30 a. m.','1:00 p. m.','1:30 p. m.','2:00 p. m.','2:30 p. m.','3:00 p. m.']
const today=new Date(); today.setHours(0,0,0,0)
const dateKey=(d:Date)=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`
const pretty=(iso:string)=>new Date(`${iso}T12:00:00`).toLocaleDateString('es-DO',{weekday:'long',day:'numeric',month:'long'})
const seed:Booking[]=[
 {id:'demo-1',doctorId:'d1',doctor:'Dra. Camila Reyes',specialty:'Medicina general',initials:'CR',color:'sage',date:dateKey(new Date(today.getTime()+86400000)),time:'9:30 a. m.',status:'Confirmada',location:'Consultorio 204 · Sede Piantini'},
 {id:'demo-2',doctorId:'d3',doctor:'Dra. Laura Méndez',specialty:'Dermatología',initials:'LM',color:'peach',date:dateKey(new Date(today.getTime()+86400000*5)),time:'11:00 a. m.',status:'Pendiente',location:'Consultorio 108 · Sede Naco'},
]
function loadDemo():Booking[]{try{const s=localStorage.getItem('turnocero-bookings');return s?JSON.parse(s) as Booking[]:seed}catch{return seed}}

function welcomeScreen(){return(<div className="welcome-screen"><div className="welcome-card"><div className="welcome-header"><h2>¡Bienvenido a TurnoCero!</h2><p className="subtitle">Agenda tu consulta médica de forma rápida y sencilla</p></div><div className="welcome-body"><div className="form-group"><label>Nombre completo</label><input type="text" value={userName} onChange={e=>setUserName(e.target.value)} placeholder="Ej: Juan Pérez" required/></div><div className="form-group"><label>Teléfono</label><input type="tel" value={userPhone} onChange={e=>setUserPhone(e.target.value)} placeholder="Ej: 809-123-4567" required/></div><div className="actions"><button className="primary-btn" onClick={()=>{setShowWelcome(false);setActiveTab('inicio')}}>Comenzar</button><button className="secondary-btn" onClick={()=>{setShowWelcome(false)}}>Salt</button></div></div></div></div>)}
 const [bookings,setBookings]=useState<Booking[]>(loadDemo)
 const [specialty,setSpecialty]=useState('Todas')
 const [query,setQuery]=useState('')
 const [activeTab,setActiveTab]=useState<'inicio'|'citas'>('inicio')
 const [modal,setModal]=useState<Doctor|null>(null)
 const [bookingStep,setBookingStep]=useState(1)
 const [chosenDate,setChosenDate]=useState(dateKey(new Date(today.getTime()+86400000)))
 const [chosenTime,setChosenTime]=useState('')
 const [searchOpen,setSearchOpen]=useState(false)
const [user,setUser]=useState<{id:string;email?:string}|null>(null)
  const [authOpen,setAuthOpen]=useState(false)
  const [authEmail,setAuthEmail]=useState('')
  const [notice,setNotice]=useState('')
  const [busy,setBusy]=useState(false)
  const [menuOpen,setMenuOpen]=useState(false)
  const [darkMode,setDarkMode]=useState(()=>localStorage.getItem('turnocero-theme')==='dark')
  // Estados para bienvenida y ticket
  const [showWelcome,setShowWelcome]=useState(true)
  const [userName,setUserName]=useState('')
  const [userPhone,setUserPhone]=useState('')
  const [turnNumber,setTurnNumber]=useState('')
  const [showTicket,setShowTicket]=useState(false)

 useEffect(()=>{localStorage.setItem('turnocero-theme',darkMode?'dark':'light')},[darkMode])

 useEffect(()=>{if(!supabase)return;supabase.auth.getSession().then(({data})=>setUser(data.session?.user?{id:data.session.user.id,email:data.session.user.email}:null));const{data:{subscription}}=supabase.auth.onAuthStateChange((_e,s)=>setUser(s?.user?{id:s.user.id,email:s.user.email}:null));return()=>subscription.unsubscribe()},[])
 useEffect(()=>{if(!supabase||!user)return;let live=true;supabase.from('appointments').select('*').order('appointment_date').then(({data,error})=>{if(error){notify('No se pudieron cargar tus citas. Revisa el esquema de Supabase.');return}if(live&&data)setBookings(data.map((r:any)=>({...r,id:r.id,doctor:r.doctor_name,date:r.appointment_date,time:r.appointment_time,status:r.status==='confirmed'?'Confirmada':r.status==='pending'?'Pendiente':'Cancelada'}))) });return()=>{live=false}},[user])
 const filtered=useMemo(()=>doctors.filter(d=>(specialty==='Todas'||d.specialty===specialty)&&`${d.name} ${d.specialty}`.toLowerCase().includes(query.toLowerCase())),[specialty,query])
 const upcoming=bookings.filter(b=>b.status!=='Cancelada'&&b.date>=dateKey(today)).sort((a,b)=>a.date.localeCompare(b.date))
 const nextBooking=upcoming[0]
 function notify(s:string){setNotice(s);window.setTimeout(()=>setNotice(''),3600)}
 function openBooking(doc:Doctor){setModal(doc);setBookingStep(1);setChosenTime('');setChosenDate(dateKey(new Date(today.getTime()+86400000)))}
 async function confirmBooking(){if(!modal||!chosenTime)return;setBusy(true);const b:Booking={id:crypto.randomUUID(),doctorId:modal.id,doctor:modal.name,specialty:modal.specialty,initials:modal.initials,color:modal.color,date:chosenDate,time:chosenTime,status:'Confirmada',location:modal.location};
  if(supabase&&user){const {error}=await supabase.from('appointments').insert({id:b.id,user_id:user.id,doctor_id:b.doctorId,doctor_name:b.doctor,specialty:b.specialty,appointment_date:b.date,appointment_time:b.time,status:'confirmed',location:b.location});if(error){setBusy(false);notify(error.code==='23P01'?'Ese horario acaba de ocuparse. Elige otro.':'No se pudo guardar la cita. Inténtalo de nuevo.');return}}
  const next=[b,...bookings];setBookings(next);if(!supabase||!user)localStorage.setItem('turnocero-bookings',JSON.stringify(next));setBusy(false);setModal(null);setActiveTab('citas');notify('¡Cita reservada! Recibirás la confirmación por correo.')}
 async function cancelBooking(b:Booking){if(supabase&&user){const{error}=await supabase.from('appointments').update({status:'cancelled'}).eq('id',b.id).eq('user_id',user.id);if(error){notify('No se pudo cancelar la cita.');return}}const next=bookings.map(x=>x.id===b.id?{...x,status:'Cancelada' as const}:x);setBookings(next);if(!supabase||!user)localStorage.setItem('turnocero-bookings',JSON.stringify(next));notify('Cita cancelada correctamente.')}
 async function signIn(e:React.FormEvent){e.preventDefault();if(!supabase){notify('Configura Supabase para activar el acceso seguro.');return}setBusy(true);const{error}=await supabase.auth.signInWithOtp({email:authEmail,options:{emailRedirectTo:window.location.origin}});setBusy(false);if(error)notify(error.message);else{setAuthOpen(false);notify('Te enviamos un enlace seguro para iniciar sesión.')}}
 const week=Array.from({length:7},(_,i)=>new Date(today.getTime()+86400000*(i+1)))
 return <div className={`app-shell ${darkMode?'dark':''}`}><aside className={`sidebar ${menuOpen?'sidebar-open':''}`}><a className="brand" href="#inicio"><span className="brand-mark"><Activity size={19} strokeWidth={2.3}/></span><span>turno<span className="brand-light">cero</span></span></a><div className="side-label">MENÚ PRINCIPAL</div><button className={`nav-item ${activeTab==='inicio'?'active':''}`} onClick={()=>{setActiveTab('inicio');setMenuOpen(false)}}><span className="nav-icon"><Activity size={17}/></span>Resumen</button><button className={`nav-item ${activeTab==='citas'?'active':''}`} onClick={()=>{setActiveTab('citas');setMenuOpen(false)}}><span className="nav-icon"><CalendarDays size={17}/></span>Mis citas{upcoming.length>0&&<span className="nav-count">{upcoming.length}</span>}</button><div className="side-label explore-label">EXPLORAR</div><button className="nav-item" onClick={()=>{setActiveTab('inicio');document.getElementById('specialties')?.scrollIntoView({behavior:'smooth'});setMenuOpen(false)}}><span className="nav-icon"><Stethoscope size={17}/></span>Especialidades</button><div className="sidebar-spacer"/><div className="help-card"><div className="help-spark"><Sparkles size={15}/></div><strong>Tu salud, primero.</strong><p>Agenda tu próxima consulta en menos de un minuto.</p><button onClick={()=>{setActiveTab('inicio');document.getElementById('doctors')?.scrollIntoView({behavior:'smooth'})}}>Encontrar especialista <ArrowRight size={13}/></button></div><button className="side-profile" onClick={()=>user?supabase?.auth.signOut():setAuthOpen(true)}><div className="profile-avatar">{user?'JO':'JD'}</div><span><b>{user?(user.email?.split('@')[0]||'Mi cuenta'):'Joel Demo'}</b><small>{user?'Paciente registrado':'Modo de demostración'}</small></span>{user?<LogOut size={15}/>:<ChevronDown size={15}/>}</button></aside>
 <main className="main-area"><header className="topbar"><button className="mobile-menu" onClick={()=>setMenuOpen(!menuOpen)}><Menu size={20}/></button><a className="mobile-brand brand" href="#inicio"><span className="brand-mark"><Activity size={19} strokeWidth={2.3}/></span><span>turno<span className="brand-light">cero</span></span></a><div className="breadcrumb">Portal del paciente <span>/</span> <b>{activeTab==='inicio'?'Resumen':'Mis citas'}</b></div><div className="top-actions"><button className="search-trigger" onClick={()=>setSearchOpen(!searchOpen)}><Search size={16}/><span>Buscar especialista</span><kbd>⌘ K</kbd></button><button className="avatar-top" onClick={()=>user?supabase?.auth.signOut():setAuthOpen(true)} aria-label="Iniciar sesión">{user?'JO':'JD'}</button><button className="mode-toggle" onClick={()=>setDarkMode(!darkMode)} aria-label={darkMode?'Cambiar a modo claro':'Cambiar a modo oscuro'} aria-pressed={darkMode} title={darkMode?'Cambiar a modo claro':'Cambiar a modo oscuro'}>{darkMode ? <Sun size={17} /> : <Moon size={17} />}</button></div></header>
{searchOpen&&<div className="search-pop"><Search size={17}/><input autoFocus placeholder="Nombre o especialidad..." value={query} onChange={e=>{setQuery(e.target.value);setActiveTab('inicio')}}/><button onClick={()=>{setSearchOpen(false);setQuery('')}}><X size={16}/></button></div>}
  <div className="content">{activeTab==='inicio'?welcomeScreen:activeTab==='citas'?<><section className="welcome-row"><div><div className="eyebrow"><span className="status-dot"/> TU SALUD, A TU RITMO</div><h1>Buenos días, Joel <span className="wave">✳</span></h1><p className="welcome-copy">Tu bienestar merece un espacio en tu agenda.</p></div><button className="primary-button" onClick={()=>document.getElementById('doctors')?.scrollIntoView({behavior:'smooth'})}><Plus size={17}/> Agendar una cita</button></section><Appointments bookings={bookings} onCancel={cancelBooking} onBrowse={()=>setActiveTab('inicio')} />:{}</div>
 <section className="hero-card"><div className="hero-copy"><span className="hero-tag"><HeartPulse size={13}/> CUIDARTE EMPIEZA AQUÍ</span><h2>La atención que necesitas,<br/>a un <em>clic de distancia.</em></h2><p>Encuentra profesionales de confianza y agenda<br className="desktop-break"/> cuando mejor te convenga.</p><button className="hero-button" onClick={()=>document.getElementById('doctors')?.scrollIntoView({behavior:'smooth'})}>Encontrar especialista <ArrowRight size={15}/></button></div><div className="hero-art"><div className="hero-circle circle-a"/><div className="hero-circle circle-b"/><div className="hero-cross cross-one">+</div><div className="hero-cross cross-two">+</div><div className="hero-pill"><div className="pill-icon"><HeartPulse size={19}/></div><div><b>Tu próxima cita</b><small>{nextBooking?pretty(nextBooking.date):'El momento es ahora'}</small></div><ArrowRight size={15}/></div><div className="hero-medical"><Activity size={56} strokeWidth={1.2}/></div></div><div className="hero-index">01 <span/> 03</div></section>
 <section className="stats-grid"><article className="stat-card"><div className="stat-icon mint"><CalendarDays size={17}/></div><div className="stat-label">PRÓXIMA CITA</div><div className="stat-value">{nextBooking?new Date(`${nextBooking.date}T12:00:00`).toLocaleDateString('es-DO',{day:'numeric',month:'short'}):'Sin agendar'}</div><div className="stat-foot">{nextBooking?`${nextBooking.time} · ${nextBooking.specialty}`:'Reserva tu primera consulta'}</div></article><article className="stat-card"><div className="stat-icon lilac"><ShieldCheck size={17}/></div><div className="stat-label">ESPECIALISTAS</div><div className="stat-value">{doctors.length}</div><div className="stat-foot">Profesionales de demostración</div></article><article className="stat-card"><div className="stat-icon butter"><Clock3 size={17}/></div><div className="stat-label">TIEMPO PROMEDIO</div><div className="stat-value">&lt; 2 <small>min</small></div><div className="stat-foot">Para completar una reserva</div></article></section>
 <section className="section-block" id="specialties"><div className="section-heading"><div><div className="eyebrow muted-eyebrow">ATENCIÓN INTEGRAL</div><h2>Explora por especialidad</h2><p className="specialty-intro">Elige una y compara especialistas de todas las clínicas.</p></div><button className="text-link" onClick={()=>setSpecialty('Todas')}>Ver todas <ArrowRight size={14}/></button></div><div className="specialty-grid">{[{icon:'✳',name:'Medicina general',meta:'Atención primaria',tone:'tone-mint'},{icon:'♡',name:'Cardiología',meta:'Cuida tu corazón',tone:'tone-peach'},{icon:'◈',name:'Dermatología',meta:'Salud de tu piel',tone:'tone-lavender'},{icon:'⌘',name:'Pediatría',meta:'Los más pequeños',tone:'tone-yellow'},{icon:'✿',name:'Ginecología',meta:'Salud integral de la mujer',tone:'tone-rose'}].map(s=>{const count=doctors.filter(d=>d.specialty===s.name).length;const clinics=new Set(doctors.filter(d=>d.specialty===s.name).map(d=>d.location.split('·').pop()?.trim())).size;return <button key={s.name} className={`specialty-card ${s.tone}`} onClick={()=>{setSpecialty(s.name);document.getElementById('doctors')?.scrollIntoView({behavior:'smooth'})}}><span className="specialty-symbol">{s.icon}</span><span className="specialty-name">{s.name}</span><span className="specialty-meta">{count} {count===1?'especialista':'especialistas'} en {clinics} {clinics===1?'clínica':'clínicas'}</span><span className="specialty-arrow"><ArrowRight size={15}/></span></button>})}</div></section>
 <section className="section-block doctors-section" id="doctors"><div className="section-heading"><div><div className="eyebrow muted-eyebrow">EQUIPO MÉDICO</div><h2>Profesionales para ti</h2></div><span className="result-count">{filtered.length} especialistas disponibles</span></div><div className="filter-row"><div className="filter-tabs">{specialties.map(s=><button key={s} onClick={()=>setSpecialty(s)} className={specialty===s?'selected':''}>{s}</button>)}</div><button className="sort-button"><span>Disponibilidad</span><ChevronDown size={14}/></button></div><div className="doctor-grid">{filtered.map(d=><DoctorCard key={d.id} d={d} onBook={()=>openBooking(d)}/>)}</div>{filtered.length===0&&<div className="empty-search">No encontramos especialistas con ese filtro. <button onClick={()=>{setQuery('');setSpecialty('Todas')}}>Limpiar búsqueda</button></div>}</section>
 <section className="bottom-cta"><div className="cta-icon"><ShieldCheck size={19}/></div><div><b>Tu información está protegida</b><span>Tratamos tus datos de salud con cuidado y confidencialidad.</span></div><button onClick={()=>notify('La privacidad está integrada desde el diseño de TurnoCero.')}>Conoce más <ArrowRight size={14}/></button></section></>:<Appointments bookings={bookings} onCancel={cancelBooking} onBrowse={()=>setActiveTab('inicio')} />}
 <footer className="footer"><span>© 2026 TurnoCero</span><span><i/> Tu salud, en buenas manos.</span><span>Hecho con cuidado en Santo Domingo <span className="footer-heart">♥</span></span></footer></div></main>
 {modal&&<div className="modal-backdrop" onClick={e=>{if(e.target===e.currentTarget)setModal(null)}}><div className="booking-modal"><div className="modal-top"><span className="modal-eyebrow">RESERVA TU CONSULTA</span><button className="close-modal" onClick={()=>setModal(null)}><X size={18}/></button></div><div className="step-progress"><span className={bookingStep>=1?'done':''}/><span className={bookingStep>=2?'done':''}/></div>{bookingStep===1?<><h2>Elige fecha y hora</h2><p className="modal-desc">Selecciona el horario que mejor te funcione.</p><div className="modal-doctor"><div className={`doctor-avatar ${modal.color}`}>{modal.initials}</div><div><b>{modal.name}</b><span>{modal.specialty} · RD${modal.fee.toLocaleString('es-DO')}</span></div><CheckCircle2 size={17}/></div><label className="field-label">FECHA DISPONIBLE</label><div className="date-options">{week.map(d=><button key={dateKey(d)} className={`date-option ${chosenDate===dateKey(d)?'chosen':''}`} onClick={()=>{setChosenDate(dateKey(d));setChosenTime('')}}><span>{d.toLocaleDateString('es-DO',{weekday:'short'}).replace('.','')}</span><b>{d.getDate()}</b><small>{d.toLocaleDateString('es-DO',{month:'short'}).replace('.','')}</small></button>)}</div><label className="field-label time-label">HORARIOS DISPONIBLES</label><div className="slot-grid">{slots.map((t,i)=><button key={t} disabled={i===1||i===7} className={`slot ${chosenTime===t?'chosen':''}`} onClick={()=>setChosenTime(t)}>{t}</button>)}</div><div className="modal-foot"><span><ShieldCheck size={15}/> Reserva segura y confidencial</span><button className="primary-button" disabled={!chosenTime} onClick={()=>setBookingStep(2)}>Continuar <ArrowRight size={15}/></button></div></>:<><h2>Confirma tu cita</h2><p className="modal-desc">Revisa los detalles antes de reservar.</p><div className="confirm-card"><div className={`doctor-avatar ${modal.color}`}>{modal.initials}</div><div><b>{modal.name}</b><span>{modal.specialty}</span></div></div><div className="confirm-row"><span><CalendarDays size={16}/> Fecha</span><b>{pretty(chosenDate)}</b></div><div className="confirm-row"><span><Clock3 size={16}/> Hora</span><b>{chosenTime}</b></div><div className="confirm-row"><span><UserRound size={16}/> Consulta</span><b>Presencial · RD${modal.fee.toLocaleString('es-DO')}</b></div><div className="confirm-location">{modal.location}</div><div className="modal-foot"><button className="back-button" onClick={()=>setBookingStep(1)}><ArrowLeft size={15}/> Volver</button><button className="primary-button" disabled={busy} onClick={confirmBooking}>{busy?'Guardando...':<>Confirmar cita <Check size={15}/></>}</button></div></>}</div></div>}
 {authOpen&&<div className="modal-backdrop" onClick={e=>{if(e.target===e.currentTarget)setAuthOpen(false)}}><form className="auth-modal" onSubmit={signIn}><button type="button" className="close-modal auth-close" onClick={()=>setAuthOpen(false)}><X size={18}/></button><div className="auth-brand"><span className="brand-mark"><Activity size={19}/></span></div><h2>Bienvenido a TurnoCero</h2><p>Inicia sesión con un enlace seguro enviado a tu correo.</p><label className="field-label" htmlFor="email">CORREO ELECTRÓNICO</label><input id="email" className="auth-input" required type="email" value={authEmail} onChange={e=>setAuthEmail(e.target.value)} placeholder="tu@correo.com"/><button className="primary-button auth-submit" disabled={busy}>{busy?'Enviando...':<>Enviarme un enlace <ArrowRight size={15}/></>}</button><small>No necesitas contraseña. Te enviaremos un enlace de acceso único.</small></form></div>}
 {notice&&<div className="toast"><CheckCircle2 size={17}/>{notice}<button onClick={()=>setNotice('')}><X size={15}/></button></div>}
 </div>
}
function DoctorCard({d,onBook}:{d:Doctor;onBook:()=>void}){return <article className="doctor-card"><div className={`doctor-avatar ${d.color}`}>{d.initials}<span className="online-dot"/></div><div className="doctor-info"><div className="doctor-name-row"><h3>{d.name}</h3><span className="rating">★ {d.rating}</span></div><p>{d.specialty}</p><div className="doctor-location"><span><CalendarDays size={13}/>{d.next}</span><span><Activity size={13}/>{d.location.split('·')[1]}</span></div><div className="doctor-card-bottom"><div><b>RD${d.fee.toLocaleString('es-DO')}</b><span> / consulta</span></div><button onClick={onBook}>Agendar <ArrowRight size={14}/></button></div></div></article>}
function Appointments({bookings,onCancel,onBrowse}:{bookings:Booking[];onCancel:(b:Booking)=>void;onBrowse:()=>void}){const [filter,setFilter]=useState('Todas');const list=bookings.filter(b=>filter==='Todas'||b.status===filter).sort((a,b)=>a.date.localeCompare(b.date));return <><section className="welcome-row appointments-welcome"><div><div className="eyebrow"><span className="status-dot"/> TU AGENDA</div><h1>Mis citas</h1><p className="welcome-copy">Todo lo que necesitas para cuidar de ti.</p></div><button className="primary-button" onClick={onBrowse}><Plus size={17}/> Nueva cita</button></section><div className="appointment-summary"><div><span>PRÓXIMAS</span><b>{bookings.filter(b=>b.status!=='Cancelada').length.toString().padStart(2,'0')}</b></div><div><span>CONFIRMADAS</span><b>{bookings.filter(b=>b.status==='Confirmada').length.toString().padStart(2,'0')}</b></div><div><span>PENDIENTES</span><b>{bookings.filter(b=>b.status==='Pendiente').length.toString().padStart(2,'0')}</b></div></div><section className="section-block appointment-list-section"><div className="section-heading"><div><div className="eyebrow muted-eyebrow">TU HISTORIAL</div><h2>Agenda de consultas</h2></div></div><div className="filter-tabs appointment-filters">{['Todas','Confirmada','Pendiente','Cancelada'].map(s=><button key={s} className={filter===s?'selected':''} onClick={()=>setFilter(s)}>{s==='Confirmada'?'Confirmadas':s==='Pendiente'?'Pendientes':s==='Cancelada'?'Canceladas':s}</button>)}</div>{list.length===0?<div className="empty-state"><div className="empty-icon"><CalendarDays size={23}/></div><h3>No hay citas en esta lista</h3><p>Cuando agendes una consulta, aparecerá aquí.</p><button className="primary-button" onClick={onBrowse}>Explorar especialistas <ArrowRight size={15}/></button></div>:<div className="appointment-list">{list.map(b=><article className={`appointment-card ${b.status==='Cancelada'?'cancelled':''}`} key={b.id}><div className="appointment-date"><span>{new Date(`${b.date}T12:00:00`).toLocaleDateString('es-DO',{month:'short'}).replace('.','').toUpperCase()}</span><b>{new Date(`${b.date}T12:00:00`).getDate()}</b></div><div className={`doctor-avatar ${b.color}`}>{b.initials}</div><div className="appointment-main"><b>{b.doctor}</b><span>{b.specialty} · {b.location.split('·')[1]}</span><small><Clock3 size={13}/>{b.time}</small></div><div className={`appointment-status ${b.status==='Confirmada'?'confirmed':b.status==='Pendiente'?'pending':'canceled-status'}`}><i/>{b.status}</div><div className="appointment-actions">{b.status!=='Cancelada'&&<button onClick={()=>onCancel(b)}>Cancelar</button>}<button aria-label="Ver detalles"><ArrowRight size={16}/></button></div></article>)}</div>}</section><section className="bottom-cta"><div className="cta-icon"><ShieldCheck size={19}/></div><div><b>¿Necesitas ayuda con tu cita?</b><span>Nuestro equipo está disponible para ayudarte.</span></div><button onClick={()=>window.location.href='mailto:ayuda@turnocero.do'}>Contactar <ArrowRight size={14}/></button></section></>}
